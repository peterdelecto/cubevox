Why: cubevox shares a boot block at DTCM 0x2001FF00 with its app and keeps bank 2 for data, so the board places NOINIT and ends the app flash.

diff --git a/ports/stm32h7/linker/common.ld b/ports/stm32h7/linker/common.ld
index d0bafed..f423e93 100644
--- a/ports/stm32h7/linker/common.ld
+++ b/ports/stm32h7/linker/common.ld
@@ -13,10 +13,10 @@ _estack = ORIGIN(RAM) + LENGTH(RAM);
 _stack_limit = _estack - STACK_SIZE;
 ASSERT(_stack_limit >= _heap_limit, "RAM overflowed with stack and heap");
 
-/* Noinit variables */
-_board_dfu_dbl_tap    = ORIGIN(NOINIT);       /* quick boot, dfu & app erase  */
-_board_tmp_boot_addr  = ORIGIN(NOINIT) + 4;   /* this boot address is used    */
-_board_tmp_boot_magic = ORIGIN(NOINIT) + 8;   /* if this is set to deadbeef   */
+/* Noinit variables; a board whose NOINIT holds its own layout defines the two boot address words */
+_board_dfu_dbl_tap    = ORIGIN(NOINIT);                /* quick boot, dfu & app erase  */
+PROVIDE(_board_tmp_boot_addr  = ORIGIN(NOINIT) + 4);   /* this boot address is used    */
+PROVIDE(_board_tmp_boot_magic = ORIGIN(NOINIT) + 8);   /* if this is set to deadbeef   */
 
 /* Define output sections */
 SECTIONS
diff --git a/ports/stm32h7/linker/h743xx.ld b/ports/stm32h7/linker/h743xx.ld
index 3894fe6..e626aec 100644
--- a/ports/stm32h7/linker/h743xx.ld
+++ b/ports/stm32h7/linker/h743xx.ld
@@ -1,12 +1,15 @@
 /* RM0433 - Table 7 */
 
-/* PFLASH: TinyUF2 in bank 1 sector 0, apps (PFLASH_APP) from sector 1 to the end of bank 2 */
+/* PFLASH: TinyUF2 in bank 1 sector 0, apps (PFLASH_APP) from sector 1 to the end of bank 2,
+   or to BOARD_PFLASH_APP_END (--defsym) when the board keeps the flash above it for data */
 _flash_origin = DEFINED(PFLASH_APP) ? 0x08020000 : 0x08000000;
-_flash_size = DEFINED(PFLASH_APP) ? 2048K - 128K : 128K;
+_flash_app_end = DEFINED(BOARD_PFLASH_APP_END) ? BOARD_PFLASH_APP_END : 0x08200000;
+_flash_size = DEFINED(PFLASH_APP) ? _flash_app_end - 0x08020000 : 128K;
 
 /* DTCM */
 _ram_origin = 0x20000000;
 _ram_size = 64K;
 
-_noinit_origin = _ram_origin + _ram_size;
-_noinit_size = 12;
+/* NOINIT follows the RAM unless the board places it (BOARD_NOINIT_ORIGIN, BOARD_NOINIT_SIZE) */
+_noinit_origin = DEFINED(BOARD_NOINIT_ORIGIN) ? BOARD_NOINIT_ORIGIN : _ram_origin + _ram_size;
+_noinit_size = DEFINED(BOARD_NOINIT_SIZE) ? BOARD_NOINIT_SIZE : 12;
