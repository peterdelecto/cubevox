Why: upstream counts a block the flash refused toward completion and resets, so a wrong file reboots the box; a board filter that sees the block and the transfer it would join refuses it visibly and keeps the box in update mode.

diff --git a/src/board_api.h b/src/board_api.h
index 166540c..505d2c0 100644
--- a/src/board_api.h
+++ b/src/board_api.h
@@ -123,6 +123,8 @@

 // Define TINYUF2_BOARD_INFO_UF2 to serve the board's own INFO_UF2.TXT from board_uf2_info()

+// Define TINYUF2_BOARD_BLOCK_FILTER to pass every UF2 block through board_uf2_block_accept() first
+
 //--------------------------------------------------------------------+
 // Constant
 //--------------------------------------------------------------------+
diff --git a/src/ghostfat.c b/src/ghostfat.c
index 03a5777..4111c5d 100644
--- a/src/ghostfat.c
+++ b/src/ghostfat.c
@@ -530,6 +530,11 @@ int uf2_write_block (uint32_t block_no, uint8_t *data, WriteState *state) {

   if ( !is_uf2_block(bl) ) return -1;

+#ifdef TINYUF2_BOARD_BLOCK_FILTER
+  // a refused block is neither written nor counted toward the end of the transfer
+  if ( !board_uf2_block_accept(bl, state) ) return -1;
+#endif
+
   if (bl->familyID == BOARD_UF2_FAMILY_ID) {
     // generic family ID
     board_flash_write(bl->targetAddr, bl->data, bl->payloadSize);
diff --git a/src/uf2.h b/src/uf2.h
index 4f537ec..ef8adbf 100644
--- a/src/uf2.h
+++ b/src/uf2.h
@@ -101,6 +101,11 @@ typedef struct {
     uint32_t magicEnd;
 } UF2_Block;

+// Of a board that defines TINYUF2_BOARD_BLOCK_FILTER: false refuses a UF2 block before the family
+// check, so it is neither written nor counted toward the end of the transfer. state is the
+// transfer the block would join
+bool board_uf2_block_accept(UF2_Block const* block, WriteState const* state);
+

 void uf2_init(void);
 void uf2_read_block(uint32_t block_no, uint8_t *data);
