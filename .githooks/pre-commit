#!/bin/sh
# Refuse a board commit that carries an orphan via (see hardware/tools/via_audit.py).
# Known, owner-accepted exceptions live in hardware/layout/via_allow.txt, one "x y" per line.
[ -n "$VIA_HOOK_FORCE" ] || git diff --cached --name-only | grep -q '^hardware/cubevox.kicad_pcb$' || exit 0
PY=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3
cd hardware || exit 1
out=$($PY tools/via_audit.py cubevox.kicad_pcb 2>/dev/null)
echo "$out" | tail -n +2 | while read -r net x y rest; do
  grep -q "^$x $y" layout/via_allow.txt 2>/dev/null || { echo "pre-commit: orphan via $net at $x $y (not in layout/via_allow.txt)"; exit 1; }
done || exit 1
exit 0
