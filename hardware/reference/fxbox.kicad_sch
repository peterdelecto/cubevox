	(text "H. H7 core block with audio in fitted; every port leaves on the right"
		(at 25.4 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1d74f129-4a76-539c-ad9d-49b2702f754c")
	)
	(text "I. Input: 6.35 mm springs to the ADC through 3.3k; 3.5 mm via its NC contacts; R103 DNP"
		(at 139.7 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d9aaf454-4846-55c2-9b95-b0fd8b08b7c5")
	)
	(text "R. Bypass: rest passes IN_TIP through R113 100R / R114 1k; energised LINE_L via R121 100R to the tips, LINE_R via R122 560R to the 3.5 mm ring; U7 (Section=hp_out) DNP"
		(at 292.1 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "876523fe-1fba-5ddf-b131-ea3cbc32b550")
	)
	(text "P. Pot scan: U101 channels 0-4 SIZE, PITCH, DENSITY, POSITION, MIX into PC0; 5-15 tied to GND; U101 on 3V3A with 100 nF and 2.2 uF; 100 nF at each wiper"
		(at 139.7 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "22a5fae4-004b-59e2-85b2-e7bd7e63b587")
	)
	(text "B. TAP, FREEZE, BYPASS buttons, each lit; chain TAP-FREEZE-BYPASS"
		(at 368.3 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c09bcc3c-e28a-5e27-a7c2-f888dc78e7d5")
	)
	(text "E. Encoder and D. display socket"
		(at 571.5 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "105df7a8-e9bc-5510-94c3-637e34102faa")
	)
	(text "5V_PRODUCT: barrel J106 via U103; the block's U2 prefers it over USB."
		(at 317.5 492.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a46a9c5d-2742-5747-b361-cced5897c218")
	)
	(text "W. Barrel 9-12 V either polarity: D105 SMBJ15CA, Q102/Q103 AO4606 bridge (R115-R118, D106-D109), U103 AP63205 5.0 V"
